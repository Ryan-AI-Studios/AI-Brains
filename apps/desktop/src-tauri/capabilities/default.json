{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main-window capability for T172 screens + T173 dual-layer opener (scoped https/path only)",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-ping",
    "allow-get-daemon-connection-info",
    "allow-project-briefing",
    "allow-personal-briefing",
    "allow-query-knowledge",
    "allow-inspect-evidence",
    "allow-inspect-source",
    "allow-list-review-items",
    "allow-resolve-review-item",
    "allow-resolve-scope",
    "allow-request-erasure",
    "allow-wipe-content-envelope",
    "allow-probe-health",
    "allow-open-url",
    "allow-reveal-path",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://*" }]
    },
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    }
  ]
}
