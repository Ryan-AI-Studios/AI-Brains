  "identifier": "default",
  "description": "Minimal main-window capability for T171 smoke (no menu/tray/resources)",
  "windows": ["main"],
  "permissions": [
    "core:app:default",
    "core:event:default",
    "core:window:default",
    "allow-ping",
    "allow-get-daemon-connection-info"
  ]
