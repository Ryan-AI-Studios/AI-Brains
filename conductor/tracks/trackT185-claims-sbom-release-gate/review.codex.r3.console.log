   1: # T185 ╞Æ?" L13 automated forbidden-phrase scan over elevated release docs
   2: #
   3: # Scans elevated surfaces for high-confidence affirmative overclaims.
   4: # Lines that also match a negation/allow pattern are skipped.
   5: #
   6: # Usage:
   7: #   .\scripts\check-release-claims.ps1
   8: #   .\scripts\check-release-claims.ps1 -Path C:\dev\AI-Brains
   9: #   .\scripts\check-release-claims.ps1 -Strict  # same as default hard fail
  10: #
  11: # Exit 0 if clean, 1 if hits. Complements (does not replace) human RELEASE-CLAIMS review.
  12: 
  13: param(
  14:     [string]$Path = "",
  15:     [switch]$Strict
  16: )
  17: 
  18: $ErrorActionPreference = "Stop"
  19: 
  20: if (-not $Path) {
  21:     $Path = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
  22: }
  23: $root = (Resolve-Path $Path).Path
  24: 
  25: # Elevated set per RELEASE-CLAIMS / spec A6.4 (forward-slash paths; Join-Path is OS-safe)
  26: $elevated = @(
  27:     "README.md",
  28:     "Docs/ARCHITECTURE.md",
  29:     "Docs/CAPABILITIES.md",
  30:     "Docs/OPERATIONS.md",
  31:     "Docs/README.md",
  32:     "Docs/INSTALL.md",
  33:     "Docs/SECURITY-LIMITS.md",
  34:     "SECURITY.md",
  35:     "CHANGELOG.md",
  36:     "Docs/RELEASE-CLAIMS.md",
  37:     "Docs/RELEASE-CHECKLIST.md"
  38: )
  39: 
  40: # High-confidence forbidden affirmative patterns (regex)
  41: # Keep practical: fail on clear overclaims; allow non-claim / residual discussion.
  42: $rules = @(
  43:     @{ Name = "SOC2 certified"; Pattern = '\bSOC\s*2\s+certified\b' },
  44:     @{ Name = "ISO 27001 certified"; Pattern = '\bISO\s*27001\s+certified\b' },
  45:     @{ Name = "perfect deletion"; Pattern = '\bperfect\s+deletion\b' },
  46:     @{ Name = "metadata-private (product property)"; Pattern = '\bmetadata-private\b' },
  47:     @{ Name = "SLSA Build L3 achieved"; Pattern = '\bSLSA\s*(Build\s*)?L3\b' },
  48:     @{ Name = "SLSA certified"; Pattern = '\bSLSA\s+certified\b' },
  49:     @{ Name = "fully compliant (SSDF/OpenSSF)"; Pattern = '\bfully\s+compliant\b' },
  50:     @{ Name = "tamper-proof supply chain"; Pattern = '\btamper-proof\s+supply\s+chain\b' },
  51:     @{ Name = "full DB encryption (unqualified)"; Pattern = '\bfull\s+(DB|database)\s+encryption\b' },
  52:     @{ Name = "SQLCipher encrypts the database (unqualified)"; Pattern = '\bSQLCipher\s+encrypts\s+the\s+database\b' },
  53:     @{ Name = "plugin sandbox shipped"; Pattern = '\b(plugin|third-party)\s+sandbox\s+(is\s+)?(shipped|enabled|available)\b' },
  54:     @{ Name = "invented doctor CLI as shipped"; Pattern = '\bai-brains\s+doctor\b(?!.*\b(not|no|non-|DTO|type|contract)\b)' },
  55:     @{ Name = "invented recovery export CLI as shipped"; Pattern = '\bai-brains\s+recovery\s+export\b(?!.*\b(not|no|non-|not shipped|kit|drill)\b)' }
  56: )
  57: 
  58: # If a matching line also hits this, treat as non-claim / residual honesty context.
  59: # Tightened after R2: do NOT free-pass on residual IDs alone or bare "without"
  60: # (those can appear on affirmative marketing lines). Require real negation /
  61: # forbidden-inventory / non-claim framing.
  62: $allowIf = '(?i)(\b(not|no|non-|never|forbidden|non-claim|must not|do not|don''t|out of scope|explicitly not|does not|isn''t|cannot|can''t|prohibited|denied|unclaimed|no claim|as a product property|without\s+F8|qualifier)\b|Do\s+\*\*not\*\*\s+claim|\bnot\s+(claimed|a claim|shipped|live|supported)\b)'
  63: 
  64: function Test-IsForbiddenInventoryLine {
  65:     param([string]$Line)
  66:     # List/inventory of forbidden phrases: bullets that only quote/backtick the term
  67:     # e.g. - "Perfect deletion"  /  - `metadata-private` as a product property
  68:     if ($Line -match '^\s*[-*]\s+[`"''].*[`"'']') { return $true }
  69:     if ($Line -match '^\s*[-*]\s+`[^`]+`') { return $true }
  70:     # Table cells documenting non-claim / forbidden class names
  71:     if ($Line -match '(?i)\|\s*.*\b(non-claim|forbidden|residual|must not|do not)\b') { return $true }
  72:     return $false
  73: }
  74: 
  75: Write-Host "=== check-release-claims.ps1 ===" -ForegroundColor Cyan
  76: Write-Host "  Root: $root"
  77: Write-Host "  Elevated files: $($elevated.Count)"
  78: 
  79: $hits = @()
  80: $scanned = 0
  81: $missing = @()
  82: 
  83: foreach ($rel in $elevated) {
  84:     $full = Join-Path $root $rel
  85:     if (-not (Test-Path $full)) {
  86:         $missing += $rel
  87:         Write-Host "  [SKIP missing] $rel" -ForegroundColor Yellow
  88:         continue
  89:     }
  90:     $scanned++
  91:     $lines = Get-Content $full
  92:     # Track recent "forbidden / non-claim inventory" section headers (soft window)
  93:     $inForbiddenSection = $false
  94:     for ($i = 0; $i -lt $lines.Count; $i++) {
  95:         $line = $lines[$i]
  96:         # Skip pure markdown table separators
  97:         if ($line -match '^\s*\|[\s\-:|]+\|\s*$') { continue }
  98: 
  99:         if ($line -match '(?i)^#{1,4}\s+.*(forbidden|non-claim|what this release does not|illustrative forbidden)') {
 100:             $inForbiddenSection = $true
 101:         } elseif ($line -match '^#{1,4}\s+') {
 102:             $inForbiddenSection = $false
 103:         }
 104: 
 105:         foreach ($rule in $rules) {
 106:             if ($line -notmatch $rule.Pattern) { continue }
 107: 
 108:             # Allow if line carries negation / residual / non-claim context
 109:             if ($line -match $allowIf) { continue }
 110: 
 111:             # Extra guard: policy bullets / inventory of forbidden phrases
 112:             if ($line -match '(?i)(non-claim|forbidden|must remain|must not appear|do not claim|do \*\*not\*\* claim)') { continue }
 113:             if (Test-IsForbiddenInventoryLine $line) { continue }
 114:             if ($inForbiddenSection) { continue }
 115: 
 116:             $hits += [pscustomobject]@{
 117:                 File    = $rel
 118:                 Line    = $i + 1
 119:                 Rule    = $rule.Name
 120:                 Text    = $line.Trim()
 121:             }
 122:         }
 123:     }
 124: }
 125: 
 126: if ($missing.Count -gt 0) {
 127:     Write-Host "  Missing elevated files: $($missing -join ', ')" -ForegroundColor Yellow
 128: }
 129: 
 130: if ($hits.Count -eq 0) {
 131:     Write-Host "[OK] No forbidden affirmative claims in $scanned elevated file(s)" -ForegroundColor Green
 132:     exit 0
 133: }
 134: 
 135: Write-Host ""
 136: Write-Host "[FAIL] $($hits.Count) elevated claim hit(s):" -ForegroundColor Red
 137: foreach ($h in $hits) {
 138:     Write-Host "  $($h.File):$($h.Line) [$($h.Rule)]" -ForegroundColor Red
 139:     Write-Host "    $($h.Text)"
 140: }
 141: 
 142: # Always hard-fail on hits (L13). -Strict reserved for future soft modes.
 143: exit 1

