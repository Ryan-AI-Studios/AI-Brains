   1: #!/usr/bin/env bash
   2: # T185 ╞Æ?" Generate CycloneDX SBOMs for shipped binaries (POSIX mirror)
   3: #
   4: # Feature set / target:
   5: #   - Default target: x86_64-unknown-linux-gnu (override with TARGET=)
   6: #   - Default features: package defaults (NOT blind --all-features)
   7: #   - Spec: CycloneDX JSON 1.5 via cargo-cyclonedx --describe binaries
   8: #   - Shipped by default: ai-brains + ai-brainsd
   9: #
  10: # Usage:
  11: #   ./scripts/generate-sbom.sh
  12: #   TARGET=x86_64-unknown-linux-gnu VERSION=0.1.1 ./scripts/generate-sbom.sh
  13: #   INCLUDE_DESKTOP=1 ./scripts/generate-sbom.sh
  14: #
  15: # Requires: cargo-cyclonedx 0.5.9+ (Apache-2.0). See Docs/ci-tooling.md.
  16: 
  17: set -euo pipefail
  18: 
  19: ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
  20: cd "$ROOT"
  21: 
  22: TARGET="${TARGET:-x86_64-unknown-linux-gnu}"
  23: VERSION="${VERSION:-}"
  24: INCLUDE_DESKTOP="${INCLUDE_DESKTOP:-0}"
  25: 
  26: if [[ -z "${SOURCE_DATE_EPOCH:-}" ]]; then
  27:   if epoch="$(git log -1 --format=%ct 2>/dev/null)" && [[ "$epoch" =~ ^[0-9]+$ ]]; then
  28:     export SOURCE_DATE_EPOCH="$epoch"
  29:     echo "SOURCE_DATE_EPOCH set from git: $epoch"
  30:   fi
  31: fi
  32: 
  33: if [[ -z "$VERSION" ]]; then
  34:   VERSION="$(sed -n '/\[workspace\.package\]/,/^\[/p' Cargo.toml | sed -n 's/^version *= *"\([^"]*\)".*/\1/p' | head -n1)"
  35:   if [[ -z "$VERSION" ]]; then
  36:     echo "ERROR: could not parse workspace version; set VERSION=" >&2
  37:     exit 1
  38:   fi
  39: fi
  40: 
  41: echo "=== generate-sbom.sh ==="
  42: echo "  Version: $VERSION"
  43: echo "  Target:  $TARGET"
  44: echo "  Features: package defaults (not --all-features)"
  45: 
  46: if ! command -v cargo-cyclonedx >/dev/null 2>&1 && ! cargo cyclonedx --version >/dev/null 2>&1; then
  47:   echo "ERROR: cargo-cyclonedx not found. Install: cargo install --locked cargo-cyclonedx" >&2
  48:   exit 1
  49: fi
  50: 
  51: cargo cyclonedx --format json --spec-version 1.5 --describe binaries --target "$TARGET" --target-in-filename
  52: 
  53: mkdir -p dist/sbom
  54: 
  55: copy_validate() {
  56:   local bin="$1"
  57:   local out="dist/sbom/${bin}-${VERSION}.cdx.json"
  58:   local pattern="${bin}_bin_${TARGET}.cdx.json"
  59:   local src
  60:   src="$(find . -name "$pattern" \
  61:     -not -path './target/*' -not -path './dist/*' -not -path './.git/*' 2>/dev/null | head -n1 || true)"
  62:   if [[ -z "$src" ]]; then
  63:     echo "ERROR: missing SBOM for shipped binary '$bin' ($pattern)" >&2
  64:     exit 1
  65:   fi
  66:   cp -f "$src" "$out"
  67:   local spec
  68:   spec="$(python3 -c "import json,sys; print(json.load(open(sys.argv[1])).get('specVersion',''))" "$out" 2>/dev/null \
  69:     || grep -o '"specVersion"[[:space:]]*:[[:space:]]*"[^"]*"' "$out" | head -n1 | sed 's/.*"\([0-9.]*\)".*/\1/')"
  70:   if [[ "$spec" != "1.5" ]]; then
  71:     echo "ERROR: $out has specVersion='$spec' (expected 1.5)" >&2
  72:     exit 1
  73:   fi
  74:   echo "  [OK] $out (specVersion 1.5) from $src"
  75: }
  76: 
  77: copy_validate "ai-brains"
  78: copy_validate "ai-brainsd"
  79: 
  80: if [[ "$INCLUDE_DESKTOP" == "1" ]]; then
  81:   desk="$(find ./apps -name "*_bin_${TARGET}.cdx.json" -not -path '*/target/*' 2>/dev/null | head -n1 || true)"
  82:   if [[ -z "$desk" ]]; then
  83:     echo "ERROR: INCLUDE_DESKTOP=1 but no desktop BOM under apps/" >&2
  84:     exit 1
  85:   fi
  86:   out="dist/sbom/ai-brains-desktop-${VERSION}.cdx.json"
  87:   cp -f "$desk" "$out"
  88:   echo "  [OK] $out"
  89: fi
  90: 
  91: # Clean only cargo-cyclonedx generator outputs under crates/ and apps/.
  92: # Never delete conductor/ or evidence/ dry-run archives.
  93: find ./crates ./apps -name '*.cdx.json' -type f -print -delete 2>/dev/null || true
  94: 
  95: echo "[SUCCESS] SBOMs written under dist/sbom/"

