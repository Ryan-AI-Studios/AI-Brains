  12: #   .\scripts\generate-sbom.ps1 -Target x86_64-pc-windows-msvc -Version 0.1.1
  13: #   .\scripts\generate-sbom.ps1 -IncludeDesktop
  14: #
  15: # Requires: cargo-cyclonedx 0.5.9+ (Apache-2.0). See Docs/ci-tooling.md.
  16: 
  17: param(
  18:     [string]$Target = "x86_64-pc-windows-msvc",
  19:     [string]$Version = "",
  20:     [switch]$IncludeDesktop,
  21:     [string]$RepoRoot = ""
  22: )
  23: 
  24: $ErrorActionPreference = "Stop"
  25: 
  26: if (-not $RepoRoot) {
  27:     $RepoRoot = (Resolve-Path (Join-Path $PSScriptRoot "..")).Path
  28: }
  29: Set-Location $RepoRoot
  30: 
  31: # Soft SOURCE_DATE_EPOCH from git for more reproducible SBOM timestamps
  32: if (-not $env:SOURCE_DATE_EPOCH) {
  33:     try {
  34:         $epoch = (git log -1 --format=%ct 2>$null)
  35:         if ($epoch -and $epoch -match '^\d+$') {
  36:             $env:SOURCE_DATE_EPOCH = $epoch
  37:             Write-Host "SOURCE_DATE_EPOCH set from git: $epoch"
  38:         }
  39:     } catch {
  40:         Write-Host "SOURCE_DATE_EPOCH not set (git unavailable)"
  41:     }
  42: }
  43: 
  44: # Resolve product version from workspace Cargo.toml if not provided
  45: if (-not $Version) {
  46:     $cargoToml = Get-Content (Join-Path $RepoRoot "Cargo.toml") -Raw
  47:     if ($cargoToml -match '(?ms)\[workspace\.package\].*?^version\s*=\s*"([^"]+)"') {
  48:         $Version = $Matches[1]
  49:     } else {
  50:         Write-Error "Could not parse [workspace.package] version from Cargo.toml; pass -Version"
  51:         exit 1
  52:     }
  53: }
  54: 
  55: Write-Host "=== generate-sbom.ps1 ===" -ForegroundColor Cyan
  56: Write-Host "  Version: $Version"
  57: Write-Host "  Target:  $Target"
  58: Write-Host "  Features: package defaults (not --all-features)"
  59: Write-Host "  Spec:    CycloneDX 1.5 / --describe binaries"
  60: 
  61: # Verify tool
  62: $toolVer = $null
  63: try {
  64:     $raw = cargo cyclonedx --version 2>&1 | Select-Object -First 1
  65:     if ($raw -match '(\d+\.\d+\.\d+)') { $toolVer = $Matches[1] }
  66: } catch {}
  67: if (-not $toolVer) {
  68:     Write-Error "cargo-cyclonedx not found. Install: cargo install --locked cargo-cyclonedx"
  69:     exit 1
  70: }
  71: Write-Host "  cargo-cyclonedx: $toolVer"
  72: 
  73: # Generate next to crates (tool default layout)
  74: cargo cyclonedx --format json --spec-version 1.5 --describe binaries --target $Target --target-in-filename
  75: if ($LASTEXITCODE -ne 0) {
  76:     Write-Error "cargo cyclonedx failed with exit $LASTEXITCODE"
  77:     exit $LASTEXITCODE
  78: }
  79: 
  80: $distSbom = Join-Path $RepoRoot "dist\sbom"
  81: New-Item -ItemType Directory -Force -Path $distSbom | Out-Null
  82: 
  83: # Pattern: {bin}_bin_{target}.cdx.json
  84: function Find-BinBom {
  85:     param([string]$BinName, [string]$Tgt)
  86:     $pattern = "${BinName}_bin_${Tgt}.cdx.json"
  87:     $found = Get-ChildItem -Path $RepoRoot -Recurse -Filter $pattern -ErrorAction SilentlyContinue |
  88:         Where-Object { $_.FullName -notmatch '[\\/]target[\\/]' -and $_.FullName -notmatch '[\\/]dist[\\/]' } |
  89:         Select-Object -First 1
  90:     return $found
  91: }
  92: 
  93: function Copy-And-Validate {
  94:     param(
  95:         [string]$BinName,
  96:         [string]$OutName
  97:     )
  98:     $src = Find-BinBom -BinName $BinName -Tgt $Target
  99:     if (-not $src) {
 100:         Write-Error "Missing SBOM for shipped binary '$BinName' (expected *${BinName}_bin_${Target}.cdx.json)"
 101:         exit 1
 102:     }
 103:     $dest = Join-Path $distSbom $OutName
 104:     Copy-Item -Force $src.FullName $dest
 105:     $json = Get-Content $dest -Raw | ConvertFrom-Json
 106:     if ($json.specVersion -ne "1.5") {
 107:         Write-Error "SBOM $OutName has specVersion='$($json.specVersion)' (expected 1.5)"
 108:         exit 1
 109:     }
 110:     Write-Host "  [OK] $OutName (specVersion 1.5) from $($src.FullName)" -ForegroundColor Green
 111:     return $src.FullName
 112: }
