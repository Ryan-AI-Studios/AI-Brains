# T185 - Soft release workflow (SBOM / NOTICE / claims / optional attest)
#
# Triggers: v* tags + workflow_dispatch.
# F26: EVERY uses: entry is SHA-pinned (floating majors forbidden in this file).
# PR CI (.github/workflows/ci.yml) may keep floating majors until T186.
#
# R-SLSA honesty:
#   - Optional GitHub Artifact Attestations via actions/attest (Build L1-oriented).
#   - Do NOT claim SLSA Build L3, "SLSA certified", or tamper-proof supply chain.
#   - Public repos (or Enterprise Cloud private) only; otherwise skip attest.
#
# Permissions: least privilege; id-token: write only for attest job/steps.
# Windows shell: pwsh; use ; not &&.
#
# SHA pins resolved 2026-08-01 (peel annotated tags  commit):
#   actions/checkout@v4                           11d5960a326750d5838078e36cf38b85af677262
#   dtolnay/rust-toolchain@v1                     e97e2d8cc328f1b50210efc529dca0028893a2d9
#   Swatinem/rust-cache@v2                        e18b497796c12c097a38f9edb9d0641fb99eee32
#   actions/attest@v2.4.0                         ce27ba3b4a9a139d9a20a4a07d69fabb52f1e5bc
#   softprops/action-gh-release@v2                3bb12739c298aeb8a4eeaf626c5b8d85266b0e65
#   actions/upload-artifact@v4                    ea165f8d65b6e75b540449e92b4886f43607fa02

name: Release

on:
  push:
    tags:
      - "v*"
  workflow_dispatch:
    inputs:
      skip_attest:
        description: "Skip provenance attestation (R-SLSA soft skip)"
        type: boolean
        default: false
      create_github_release:
        description: "Upload assets via softprops/action-gh-release"
        type: boolean
        default: true

# Default read; jobs opt into write scopes.
permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1
  # Release feature/target honesty (not --all-features)
  RELEASE_TARGET: x86_64-pc-windows-msvc

jobs:
  release-windows:
    name: release-windows (windows-2025)
    runs-on: windows-2025
    permissions:
      contents: write
      id-token: write
      attestations: write
    defaults:
      run:
        shell: pwsh
    steps:
      - name: Checkout
        uses: actions/checkout@11d5960a326750d5838078e36cf38b85af677262 # v4

      - name: Install Rust toolchain 1.95.0
        uses: dtolnay/rust-toolchain@e97e2d8cc328f1b50210efc529dca0028893a2d9 # v1
        with:
          toolchain: "1.95.0"
          components: rustfmt, clippy
          targets: x86_64-pc-windows-msvc

      - name: Cache cargo
        uses: Swatinem/rust-cache@e18b497796c12c097a38f9edb9d0641fb99eee32 # v2
        continue-on-error: true

      - name: Install release-gate tools
        run: |
          $ErrorActionPreference = "Stop"
          cargo install cargo-cyclonedx --locked --version 0.5.9
          cargo install cargo-about --locked --version 0.9.1 --features cli
          cargo install cargo-deny --locked --version 0.20.2
          cargo install cargo-audit --locked --version 0.22.2

      - name: SCA gate (deny + audit)
        run: |
          $ErrorActionPreference = "Stop"
          cargo deny check
          cargo audit

      - name: Claims scan (L13)
        run: |
          $ErrorActionPreference = "Stop"
          .\scripts\check-release-claims.ps1

      - name: Version banners (soft)
        run: |
          $ErrorActionPreference = "Stop"
          .\scripts\check-version-banners.ps1

      - name: Build release binaries
        run: |
          $ErrorActionPreference = "Stop"
          cargo build --release -p ai-brains-cli -p ai-brainsd --target $env:RELEASE_TARGET

      - name: Generate SBOM (CycloneDX 1.5)
        run: |
          $ErrorActionPreference = "Stop"
          .\scripts\generate-sbom.ps1 -Target $env:RELEASE_TARGET

      - name: Generate THIRD-PARTY notices
        run: |
          $ErrorActionPreference = "Stop"
          .\scripts\generate-notices.ps1

      - name: Stage dist binaries
        run: |
          $ErrorActionPreference = "Stop"
          $binDir = "target\$env:RELEASE_TARGET\release"
          Copy-Item -Force "$binDir\ai-brains.exe" "dist\ai-brains.exe"
          Copy-Item -Force "$binDir\ai-brainsd.exe" "dist\ai-brainsd.exe"
          Copy-Item -Force "LICENSE" "dist\LICENSE"

      - name: Generate checksums
        run: |
          $ErrorActionPreference = "Stop"
          .\scripts\generate-checksums.ps1

      - name: Upload dist artifact
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02 # v4
        with:
          name: ai-brains-windows-x64
          path: dist/

      # Soft attest (R-SLSA L1-oriented). Skip if dispatch says so.
      # Honest language only - not SLSA L3.
      - name: Attest build provenance (soft L1-oriented)
        if: ${{ github.event_name != 'workflow_dispatch' || inputs.skip_attest != true }}
        continue-on-error: true
        uses: actions/attest@ce27ba3b4a9a139d9a20a4a07d69fabb52f1e5bc # v2.4.0
        with:
          subject-path: |
            dist/ai-brains.exe
            dist/ai-brainsd.exe

      - name: Create GitHub Release (optional)
        if: ${{ startsWith(github.ref, 'refs/tags/') && (github.event_name != 'workflow_dispatch' || inputs.create_github_release != false) }}
        uses: softprops/action-gh-release@3bb12739c298aeb8a4eeaf626c5b8d85266b0e65 # v2
        with:
          files: |
            dist/ai-brains.exe
            dist/ai-brainsd.exe
            dist/LICENSE
            dist/THIRD-PARTY.md
            dist/sbom/*
            dist/checksums/SHA256SUMS
          generate_release_notes: true
          fail_on_unmatched_files: false


