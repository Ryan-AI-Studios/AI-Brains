  26: use std::io;
  27: 
  28: use windows::{
  29:     Win32::Security::{
  30:         Authorization::ConvertStringSecurityDescriptorToSecurityDescriptorA, PSECURITY_DESCRIPTOR,
  31:         SECURITY_ATTRIBUTES,
  32:     },
  33:     core::PCSTR,
  34: };
  35: 
  36: /// SYSTEM + Administrators + Interactive (not World/Everyone).
  37: /// See module docs and T184 finding F-1.
  38: const SDDL: &str = "D:(A;;GA;;;SY)(A;;GA;;;BA)(A;;GA;;;IU)";
  39: 
  40: pub fn build_pipe_security_attributes() -> io::Result<SECURITY_ATTRIBUTES> {
  41:     let mut psd: PSECURITY_DESCRIPTOR = PSECURITY_DESCRIPTOR::default();
  42: 
  43:     let result = unsafe {
  44:         ConvertStringSecurityDescriptorToSecurityDescriptorA(
  45:             PCSTR(SDDL.as_ptr()),
  46:             1,
  47:             &mut psd,
  48:             None,
  49:         )
  50:     };
  51: 
  52:     if result.is_err() {
  53:         return Err(io::Error::other(format!(
  54:             "ConvertStringSecurityDescriptorToSecurityDescriptorA failed: {:?}",
  55:             result
  56:         )));
  57:     }
  58: 
  59:     if psd.0.is_null() {
  60:         return Err(io::Error::other("SDDL conversion returned null SD"));
  61:     }
  62: 
  63:     let valid = unsafe { windows::Win32::Security::IsValidSecurityDescriptor(psd) };
  64:     if !valid.as_bool() {
  65:         return Err(io::Error::other("IsValidSecurityDescriptor returned false"));
  66:     }
  67: 
  68:     Ok(SECURITY_ATTRIBUTES {
  69:         nLength: std::mem::size_of::<SECURITY_ATTRIBUTES>() as u32,
  70:         lpSecurityDescriptor: psd.0,
  71:         bInheritHandle: false.into(),
  72:     })
  73: }
