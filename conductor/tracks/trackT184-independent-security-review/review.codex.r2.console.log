# AI-Brains CI - T179 Compatibility Matrix (P12.1)
# Pins: windows-2025 + ubuntu-24.04 required; macos-15 soft.
# Toolchain: 1.95.0 (matches rust-toolchain.toml).
# Do not use actions-rs/* (archived). No AGPL tools.
# cargo audit: gate on exit code only (F27) - never grep for a summary line.

name: CI

on:
  pull_request:
  push:
    branches:
      - main
  workflow_dispatch:

# Least-privilege default token (T184 / OpenSSF Token-Permissions class).
# Jobs that need write (e.g. future release/provenance) must opt in explicitly.
permissions:
  contents: read

env:
  CARGO_TERM_COLOR: always
  RUST_BACKTRACE: 1

jobs:
  # ---------------------------------------------------------------------------
  # Windows T1 - full local-gate subset (fmt / clippy / nextest)
  # deny + audit preferred on Linux job to avoid Windows App Control friction
  # ---------------------------------------------------------------------------
  gate-windows:
    name: gate-windows (windows-2025)
    runs-on: windows-2025
    defaults:
      run:
        shell: pwsh
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Rust toolchain 1.95.0
        uses: dtolnay/rust-toolchain@v1
        with:
          toolchain: "1.95.0"
          components: rustfmt, clippy
          targets: x86_64-pc-windows-msvc

      - name: Cache cargo
        uses: Swatinem/rust-cache@v2
        continue-on-error: true

      - name: Install cargo-nextest
        run: cargo install cargo-nextest --locked --version 0.9.140

      - name: cargo fmt --check
        run: cargo fmt --check

      - name: cargo clippy (workspace, all-targets, -D warnings)
        run: cargo clippy --workspace --all-targets -- -D warnings

      - name: Capture independence (no ai-brains-sync edge)
        shell: pwsh
        run: |
          $ErrorActionPreference = "Stop"
          $tree = cargo tree -p ai-brains-capture | Out-String
          if ($tree -match 'ai-brains-(sync|models|graph)(\s|$)') {
            Write-Host $tree
            Write-Error "FAIL: ai-brains-capture must not depend on sync/models/graph"
            exit 1
          }
          Write-Host "PASS: no forbidden capture edges (sync/models/graph)"

      - name: cargo nextest (workspace)
        run: cargo nextest run --workspace

  # ---------------------------------------------------------------------------
  # Linux T1 - check-before-clippy (F31) + deny + audit (exit code only)
  # ---------------------------------------------------------------------------
  gate-linux:
    name: gate-linux (ubuntu-24.04)
    runs-on: ubuntu-24.04
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Rust toolchain 1.95.0
        uses: dtolnay/rust-toolchain@v1
        with:
          toolchain: "1.95.0"
          components: rustfmt, clippy

      - name: Cache cargo
        uses: Swatinem/rust-cache@v2
        continue-on-error: true

      - name: Install CI tools (nextest, deny, audit)
        run: |
          set -euo pipefail
          cargo install cargo-nextest --locked --version 0.9.140
          cargo install cargo-deny --locked --version 0.20.2
          cargo install cargo-audit --locked --version 0.22.2

      # Desktop (Tauri) is T2 on Linux - requires WebKitGTK/GTK system packages.
      # Core CLI/daemon/store matrix excludes ai-brains-desktop (F13 honesty).
      - name: Capture independence (no ai-brains-sync edge)
        run: |
          set -euo pipefail
          tree_out="$(cargo tree -p ai-brains-capture)"
          if printf '%s\n' "$tree_out" | grep -E 'ai-brains-(sync|models|graph)( |$)' >/dev/null; then
            echo "FAIL: ai-brains-capture must not depend on sync/models/graph" >&2
            printf '%s\n' "$tree_out"
            exit 1
          fi
          echo "PASS: no forbidden capture edges (sync/models/graph)"

      - name: cargo check --workspace (exclude desktop; fail-fast cfg leakage)
        run: |
          set -euo pipefail
          cargo check --workspace --all-targets --exclude ai-brains-desktop

      - name: cargo clippy (workspace exclude desktop, all-targets, -D warnings)
        run: |
          set -euo pipefail
          cargo clippy --workspace --all-targets --exclude ai-brains-desktop -- -D warnings

      - name: cargo nextest (workspace exclude desktop)
        run: |
          set -euo pipefail
          cargo nextest run --workspace --exclude ai-brains-desktop

      - name: cargo deny check
        run: |
          set -euo pipefail
          cargo deny check

      # F27: gate on exit code only. cargo-audit 0.22.x emits no final summary on clean runs.
      - name: cargo audit (exit code only)
        run: |
          set -euo pipefail
          cargo audit

  # ---------------------------------------------------------------------------
  # macOS soft T2 - pin macos-15 (F3/F25); do not claim T1 until green smoke
  # ---------------------------------------------------------------------------
  gate-macos:
    name: gate-macos (macos-15 soft)
    runs-on: macos-15
    continue-on-error: true
    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Install Rust toolchain 1.95.0
        uses: dtolnay/rust-toolchain@v1
        with:
          toolchain: "1.95.0"
          components: rustfmt, clippy

      - name: Cache cargo
        uses: Swatinem/rust-cache@v2
        continue-on-error: true

      - name: Install cargo-nextest
        run: |
          set -euo pipefail
          cargo install cargo-nextest --locked --version 0.9.140

      # Desktop T2 on macOS (WKWebView system deps); core matrix excludes desktop (F13).
      - name: cargo check --workspace (exclude desktop)
        run: |
          set -euo pipefail
          cargo check --workspace --all-targets --exclude ai-brains-desktop

      - name: cargo nextest (workspace exclude desktop)
        run: |
          set -euo pipefail
          cargo nextest run --workspace --exclude ai-brains-desktop


