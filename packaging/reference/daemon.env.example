# AI-Brains daemon EnvironmentFile sample (systemd-oriented; T196)
# Copy to e.g. ~/.config/ai-brains/daemon.env and chmod 600.
# NEVER commit real secrets or real machine paths with keys.
#
# launchd: prefer sourcing this file from ai-brainsd.wrapper.sh.example
# rather than embedding secrets in the plist.

# REQUIRED for headless / unit-managed starts: absolute vault path (M5)
AI_BRAINS_VAULT_PATH=/home/REPLACE_ME/.ai-brains/vault.db

# Optional absolute UDS — must match CLI. Prefer unset when XDG_RUNTIME_DIR is valid (T195).
# AI_BRAINS_DAEMON_SOCKET=/run/user/REPLACE_UID/ledgerful-bridge.sock

# Operator secret — never commit real values.
# Interactive CLI commonly uses AI_BRAINS_KEY; ai-brainsd currently reads AI_BRAINS_VAULT_KEY
# (Windows service sidecar uses AI_BRAINS_VAULT_KEY). Set the variable your binary expects.
# AI_BRAINS_VAULT_KEY=x'REPLACE_WITH_64_HEX_NEVER_COMMIT'
# AI_BRAINS_KEY=x'REPLACE_WITH_64_HEX_NEVER_COMMIT'

# HTTP stays OFF by default. Do not enable non-loopback in reference templates.
# AI_BRAINS_HTTP=1
# AI_BRAINS_HTTP_PORT=7432
# FORBIDDEN in templates: AI_BRAINS_HTTP_ALLOW_NON_LOOPBACK

# Windows-only — do not use in Unix units:
# AI_BRAINS_PIPE_ACL
# AI_BRAINS_HTTP_SERVICE
